{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Voltray (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/build.sh",
                "Debug"
            ],
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "${workspaceFolder}\\scripts\\build.bat",
                    "Debug"
                ]
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
